<Window x:Class="UDP_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UDP_2"
        mc:Ignorable="d"
        Title="Recipe Server" Height="400" Width="500">
    <Grid>
        <StackPanel>
            <ListBox Name="lstRequests" Width="400" Height="200" Margin="10"/>
            <Button Content="Start Server" Click="StartServer" Width="150" Height="30" VerticalAlignment="Bottom" Margin="10"/>
            <TextBlock Name="lblStatus" Text="Server stopped" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="10"/>
        </StackPanel>
        
    </Grid>
</Window>
