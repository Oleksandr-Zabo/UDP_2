<Window x:Class="UDP_Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UDP_Client"
        mc:Ignorable="d"
        Title="Recipe Finder" Height="500" Width="400">
    <Grid>
        <StackPanel>
            <TextBox Name="txtIngredients" Width="300" Height="30" Margin="10"/>
            <Button Content="Search" Click="SendRequest" Width="100" Height="30" VerticalAlignment="Top" Margin="10"/>
            <ListBox Name="lstRecipes" Width="300" Height="150" VerticalAlignment="Bottom" Margin="10"/>
            
            <Border BorderThickness="2" BorderBrush="Black" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,10,0,10">
                <Image Name="imgRecipe" Width="150" Height="150"/>
            </Border>
        </StackPanel>
        
    </Grid>
</Window>
